# ==============================================================================
# Armor Agent - Environment Configuration Example
# Copy this file to `.env` for local development:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Project & Region
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# 2. Model Armor Configuration (Floor Settings + Diagnostic Template)
MODEL_ARMOR_TEMPLATE_ID=armor-agent-template
MODEL_ARMOR_LOCATION=us-central1

# 3. Vertex AI Agent Engine Resource Name (generated by `python scripts/deploy_agent_engine.py`)
AGENT_ENGINE_RESOURCE_NAME=projects/YOUR_PROJECT_NUMBER/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID
